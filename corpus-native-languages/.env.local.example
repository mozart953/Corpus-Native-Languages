# NextAuth needs a secret shared with the Express API.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The same value must be set as AUTH_SECRET in back/.env.
AUTH_SECRET=replace-with-the-same-secret-as-back-end

# Session cookie name. Must match AUTH_COOKIE_NAME in back/.env.
AUTH_COOKIE_NAME=corpus.session-token

# Trust the local host during development.
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Express API used by the Next.js rewrite and by NextAuth's Credentials provider.
API_URL=http://localhost:4000/api/v1

# Browser-facing prefix. Next.js rewrites /api/backend/* to API_URL/*, keeping
# requests same-origin so the session cookie is forwarded automatically.
NEXT_PUBLIC_API_BASE=/api/backend
