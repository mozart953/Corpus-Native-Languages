// Native Languages corpus — Prisma schema.
//
// SQLite is used through Prisma so the data layer can move to PostgreSQL,
// MySQL or another supported provider by changing the datasource block and
// running a migration. No provider-specific SQL is used in the application.
//
// Normal form notes
// -----------------
// * Enum-like values live in lookup tables (ReviewState, LanguageStatus,
//   PartOfSpeech, Role, UserStatus, Provider, RemovalStatus) instead of
//   unconstrained strings.
// * Language.region is a many-to-many relationship with Region, so a language
//   can be filtered or joined by region.
// * Word translations and usage notes live in Sense, one row per meaning.
// * Review and removal history live in ReviewDecision / RemovalRequest.
// * `reviewStateCode` remains on each content row as the authoritative current
//   workflow state. It is a deliberate, indexed current-state pointer; the full
//   history is in ReviewDecision.
// * Soft-delete columns (deletedAt/deletedById/deletionReason) are a documented
//   pragmatic exception: the app never physically deletes corpus rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lookup tables
// ---------------------------------------------------------------------------

model ReviewState {
  code      String           @id
  label     String
  languages Language[]
  words     Word[]
  decisions ReviewDecision[]
}

model LanguageStatus {
  code      String     @id
  label     String
  languages Language[]
}

model PartOfSpeech {
  code  String @id
  label String
  words Word[]
}

model Role {
  code  String @id
  label String
  users User[]
}

model UserStatus {
  code  String @id
  label String
  users User[]
}

model Provider {
  code  String @id
  label String
  users User[]
}

model RemovalStatus {
  code     String          @id
  label    String
  requests RemovalRequest[]
}

// Languages the interface and corpus can be translated into. Rows are data,
// not schema, so adding a new translation language never needs a migration.
model Locale {
  code      String @id
  label     String
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  position  Int     @default(0)

  pageContents      PageContent[]
  senseTranslations SenseTranslation[]
}

// ---------------------------------------------------------------------------
// Corpus
// ---------------------------------------------------------------------------

model Region {
  name      String           @id
  languages LanguageRegion[]
}

model LanguageRegion {
  languageId String
  regionName String
  position   Int      @default(0)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  region   Region   @relation(fields: [regionName], references: [name], onDelete: Cascade)

  @@id([languageId, regionName])
  @@index([regionName])
}

model Language {
  id       String @id
  name     String
  autonym  String
  speakers Int
  accent   String

  statusCode String         @default("active")
  status     LanguageStatus @relation(fields: [statusCode], references: [code])

  // Current workflow state. Public reads only expose APPROVED rows that are
  // not soft-deleted. A reviewer's approval is a recommendation; an admin's
  // approval is the final decision.
  reviewStateCode String      @default("pending")
  reviewState     ReviewState @relation(fields: [reviewStateCode], references: [code])

  createdById String?
  createdBy   User?   @relation("LanguageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Logical deletion. Reviewers request removal; only an admin deletes.
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("LanguageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions LanguageRegion[]
  entries Word[]

  @@index([reviewStateCode])
  @@index([deletedAt])
  @@index([name])
  @@index([statusCode])
}

model Word {
  id String @id @default(cuid())

  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  word          String
  pronunciation String?

  partOfSpeechCode String?
  partOfSpeech     PartOfSpeech? @relation(fields: [partOfSpeechCode], references: [code])

  // Same workflow as Language.
  reviewStateCode String      @default("pending")
  reviewState     ReviewState @relation(fields: [reviewStateCode], references: [code])

  createdById String?
  createdBy   User?   @relation("WordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("WordDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senses Sense[]

  @@index([languageId])
  @@index([word])
  @@index([reviewStateCode])
  @@index([deletedAt])
  @@index([partOfSpeechCode])
}

// A sense is the meaning itself. Its wording lives in SenseTranslation, one
// row per locale, so English is no longer special-cased in the schema.
model Sense {
  id     String @id @default(cuid())
  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations SenseTranslation[]

  @@unique([wordId, position])
  @@index([wordId])
}

model SenseTranslation {
  id      String @id @default(cuid())
  senseId String
  sense   Sense  @relation(fields: [senseId], references: [id], onDelete: Cascade)

  localeCode String
  locale     Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  gloss String
  usage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senseId, localeCode])
  @@index([senseId])
  @@index([localeCode])
  @@index([gloss])
}

// ---------------------------------------------------------------------------
// Moderation history
// ---------------------------------------------------------------------------

// One row per workflow transition or review decision. entityType/entityId are
// polymorphic (the same shape as AuditLog) because languages and words share
// the workflow but are separate tables.
model ReviewDecision {
  id         String @id @default(cuid())
  entityType String
  entityId   String

  stateCode String
  state     ReviewState @relation(fields: [stateCode], references: [code])

  reviewerId String?
  reviewer   User?   @relation("ReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  comment   String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([reviewerId])
  @@index([stateCode])
}

// A reviewer asks an admin to remove content. The request is separate from the
// content row so the full request history is retained.
model RemovalRequest {
  id         String @id @default(cuid())
  entityType String
  entityId   String

  reason String?

  statusCode String        @default("pending")
  status     RemovalStatus @relation(fields: [statusCode], references: [code])

  requestedById String?
  requestedBy   User?   @relation("RemovalRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("RemovalRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId, statusCode])
  @@index([requestedById])
  @@index([resolvedById])
  @@index([statusCode])
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String

  // Nullable so future OAuth providers (Google, etc.) can create accounts
  // without a password. Local accounts always have a bcrypt hash.
  passwordHash String?

  providerCode String   @default("local")
  provider     Provider @relation(fields: [providerCode], references: [code])
  providerId   String?

  roleCode String @default("contributor")
  role     Role   @relation(fields: [roleCode], references: [code])

  // Account lifecycle: pending -> active | rejected, active <-> deactivated.
  // Only active accounts can sign in, and the API re-checks this on every
  // authenticated request so deactivation takes effect immediately.
  statusCode      String     @default("pending")
  status          UserStatus @relation(fields: [statusCode], references: [code])
  statusReason    String?
  statusChangedAt DateTime?
  approvedAt      DateTime?

  approvedById String?
  approvedBy   User?   @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[] @relation("UserApprovedBy")

  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  languagesCreated Language[] @relation("LanguageCreatedBy")
  languagesDeleted Language[] @relation("LanguageDeletedBy")
  wordsCreated     Word[]     @relation("WordCreatedBy")
  wordsDeleted     Word[]     @relation("WordDeletedBy")
  reviewDecisions  ReviewDecision[] @relation("ReviewDecisionReviewer")
  removalsRequested RemovalRequest[] @relation("RemovalRequestRequester")
  removalsResolved  RemovalRequest[] @relation("RemovalRequestResolver")
  siteImagesUpdated SiteImage[] @relation("SiteImageUpdatedBy")
  pageContentsUpdated PageContent[] @relation("PageContentUpdatedBy")
  auditLogs         AuditLog[] @relation("AuditLogActor")

  @@unique([providerCode, providerId])
  @@index([roleCode])
  @@index([providerCode])
  @@index([statusCode])
}

// ---------------------------------------------------------------------------
// Site media
// ---------------------------------------------------------------------------

// Singleton rows for presentation media managed from the admin desk. The file
// itself lives in the server upload directory; `url` is the public API path
// stored in the database so the frontend never has to guess a filename.
model SiteImage {
  id       String  @id
  url      String
  fileName String
  mimeType String
  size     Int
  alt      String?

  updatedById String?
  updatedBy   User?   @relation("SiteImageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Editable page copy
// ---------------------------------------------------------------------------

// Admin overrides for interface strings. The English/Spanish defaults live in
// back/content/*.json; this table stores only keys an admin has changed, so a
// reset simply deletes the row and the file default applies again.
model PageContent {
  id String @id @default(cuid())

  key        String
  localeCode String
  locale     Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)
  value      String

  updatedById String?
  updatedBy   User?   @relation("PageContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, localeCode])
  @@index([localeCode])
  @@index([updatedById])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

// Every submit, review, approval, rejection, removal and restore is written
// here. The snapshot keeps the record as it was at that moment, so logically
// removed content is never actually lost. `actorEmail`/`actorRole` are
// intentional historical denormalization: they preserve the actor's identity
// at the time of the action even if the account later changes.
model AuditLog {
  id         String @id @default(cuid())
  entityType String
  entityId   String
  action     String

  fromState String?
  toState   String?

  actorId    String?
  actor      User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  actorRole  String?

  reason    String?
  snapshot  String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([actorId])
}
