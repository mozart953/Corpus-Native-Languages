# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite lives next to the Prisma schema (back/prisma/dev.db).
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Set to true only when the API runs behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# MUST be identical in back/.env and corpus-native-languages/.env.local.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-secret

# The NextAuth session cookie that Express decodes. Keep both apps in sync.
AUTH_COOKIE_NAME=corpus.session-token
# 30 minutes. NextAuth refreshes the cookie while the user is active.
AUTH_SESSION_MAX_AGE=1800

# ---------------------------------------------------------------------------
# Seed accounts (development only). Change these before any real deployment.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@corpus.local
SEED_ADMIN_USERNAME=Corpus Admin
SEED_ADMIN_PASSWORD=Admin123!

SEED_REVIEWER_EMAIL=reviewer@corpus.local
SEED_REVIEWER_USERNAME=Corpus Reviewer
SEED_REVIEWER_PASSWORD=Reviewer123!

SEED_CONTRIBUTOR_EMAIL=contributor@corpus.local
SEED_CONTRIBUTOR_USERNAME=Corpus Contributor
SEED_CONTRIBUTOR_PASSWORD=Contributor123!
